# Generated by scripts/update-cask.sh from TomTomSync's packaging/homebrew/tomtomsync.rb.in.
cask "tomtomsync" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/dzgnnl/TomTomSync/releases/download/v#{version}/TomTomSync-v#{version}.zip"
  name "TomTomSync"
  desc "Sync TomTom sports watches: FIT export, GPS QuickFix, Strava upload"
  homepage "https://github.com/dzgnnl/TomTomSync"

  depends_on macos: :sonoma

  app "TomTomSync.app"
  binary "#{appdir}/TomTomSync.app/Contents/MacOS/ttsync"

  # The app is not signed with an Apple Developer ID yet, so Gatekeeper would
  # block the quarantined download. Installing from this tap is the trust decision.
  postflight_steps do
    run "/usr/bin/xattr",
        args:           ["-dr", "com.apple.quarantine", "{{appdir}}/TomTomSync.app"],
        writable_paths: ["{{appdir}}/TomTomSync.app"]
  end

  uninstall quit: "nl.takobruinsma.TomTomSync"

  zap trash: [
    "~/Library/Application Support/TomTomSync",
    "~/Library/Preferences/nl.takobruinsma.TomTomSync.plist",
  ]
end
